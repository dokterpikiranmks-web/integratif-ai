# Next.js & Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (Gemini API with Auto-Detection)
GEMINI_API_KEY=your-gemini-api-key
# Pilihan model: 'auto' (default: otomatis mendeteksi model Flash aktif terbaru), atau tentukan manual (cth: gemini-1.5-flash, gemini-2.5-flash, gemini-3.8-flash)
GEMINI_MODEL=auto

# Cloudflare R2 / Storage (S3-compatible)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=farmatrace-storage
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLINIC_NAME="Klinik Integratif & Totok Saraf Sehat Mandiri"
NEXT_PUBLIC_DAILY_SLOT_LIMIT=5
